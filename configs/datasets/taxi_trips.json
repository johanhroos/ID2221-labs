  "quality_rules": [
    {"rule": "not_null", "column": "tpep_pickup_datetime"},
    {"rule": "not_null", "column": "tpep_dropoff_datetime"},
    {"rule": "finite", "column": "trip_distance"},
    {"rule": "finite", "column": "fare_amount"},
    {"rule": "finite", "column": "total_amount"},
