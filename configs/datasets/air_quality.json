      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Date GMT",
      "type": "date",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Time GMT",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Sample Measurement",
      "type": "double",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Units of Measure",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
