      "keep_column": true
    },
    {
      "name": "Method Type",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Method Code",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Method Name",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "State Name",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "County Name",
      "type": "string",
      "nullable": true,
      "keep_column": true
    },
    {
      "name": "Date of Last Change",
      "type": "date",
      "nullable": true,
      "keep_column": true
    }
  ],
  "extra_functions": [
    "dates_and_times_to_timestamp"
  ],
  "quality_rules": [
    {"rule": "not_null", "column": "timestamp_gmt"},
    {"rule": "not_null", "column": "sample_measurement"},
    {"rule": "finite", "column": "sample_measurement"},
    {"rule": "between", "column": "latitude", "minimum": -90, "maximum": 90},
    {"rule": "between", "column": "longitude", "minimum": -180, "maximum": 180}
  ]
}
